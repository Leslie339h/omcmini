ss="card_2_price d-flex j-sb"><view></view><view><label class="_span">合计￥</label><label class="_span">{{int.after_total}}</label></view></view><block wx:if="{{coupon_id>0&&couponDeduction>0}}"><view class="f-size-22 color-9 text-right mt-10">{{'商品￥'+int.total+"，优惠券已减￥"+couponDeduction+''}}</view></block></view><view data-event-opts="{{[['tap',[['openCouponPicker',['$event']]]]]}}" class="card_3 d-flex a-center j-sb coupon_row" bindtap="__e"><view class="card_3_left f-size-26"> 优惠券 </view><view class="d-flex a-center"><text class="f-size-26 color-9 mr-10">{{couponSummary}}</text><text class="color-9 f-size-28">›</text></view></view><view class="card_3 d-flex a-center j-sb"><view class="card_3_left f-size-26"> 备注 </view><view class="d-flex a-center"><input style="text-align:right;" type="text" placeholder="请输入您的备注要求" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"/></view></view><view class="fiexed d-flex a-center j-sb"><view class="f-size-24"><label class="_span">合计</label><label class="f-size-28 color-ff3767 _span">{{"￥"+int.after_total}}</label></view><view data-event-opts="{{[['tap',[['openpay',['$event']]]]]}}" class="fiexed_btn" bindtap="__e"> 立即支付</view></view><u-popup vue-id="5e9cb60a-1" show="{{couponPickerShow}}" mode="bottom" round="{{20}}" safeAreaInsetBottom="{{true}}" data-event-opts="{{[['^close',[['e0']]]]}}" bind:close="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="coupon_popup"><view class="coupon_popup_title">选择优惠券</view><scroll-view class="coupon_popup_scroll" scroll-y="{{true}}"><view data-event-opts="{{[['tap',[['applyCoupon',[0]]]]]}}" class="{{['coupon_popup_row','d-flex','j-sb','a-center',(coupon_id===0)?'active':'']}}" bindtap="__e"><text class="f-size-28">不使用优惠券</text><block wx:if="{{coupon_id===0}}"><text class="coupon_check">✓</text></block></view><block wx:for="{{$root.l0}}" wx:for-item="c" wx:for-index="__i2__" wx:key="id"><view data-event-opts="{{[['tap',[['applyCoupon',[c.m0]]]]]}}" class="{{['coupon_popup_row','d-flex','j-sb','a-start',(coupon_id===c.m1)?'active':'']}}" bindtap="__e"><view class="flex-1"><text class="f-size-28 f-600 color-ff3767">{{"减¥"+c.$orig.used_amount}}</text><text class="f-size-22 color-9 ml-12">{{"满"+c.$orig.with_amount+"可用"}}</text><view class="f-size-26 mt-8">{{c.$orig.title}}</view></view><block wx:if="{{coupon_id===c.m2}}"><text class="coupon_check mt-4">✓</text></block></view></block><block wx:if="{{$root.g1===0}}"><view class="coupon_popup_empty f-size-26 color-9">暂无可用优惠券</view></block></scroll-view></view></u-popup><pay-pop vue-id="5e9cb60a-2" pageurl="{{pageurl}}" createObj="{{createObj}}" popShow="{{popShow}}" data-event-opts="{{[['^close',[['e1']]]]}}" bind:close="__e" bind:__l="__l"></pay-pop></view>