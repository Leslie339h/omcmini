<view hidden="{{!(pageShow)}}"><block wx:if="{{pageShow}}"><view class="order_status_head flexs flexc"><view class="order_status_head_left f-bold f-size-36"> 商城订单状态 </view><view class="order_status_head_right f-size-28 color-03">{{''+(int.status_text||'--')+''}}</view></view></block><block wx:if="{{installFlowDetailTip}}"><view class="install_tip_detail">{{''+installFlowDetailTip+''}}</view></block><view class="box_2"><view class="store"><view><storelocation vue-id="fb91a30a-1" addShow="{{true}}" content_list="{{int}}" bind:__l="__l"></storelocation></view><block wx:for="{{int.detail}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="content_detail"><view class="content_left"><view class="content_left_img"><image src="{{item.image}}" mode="aspectFill"></image></view><view class="content_left_title d-flex flex-column j-sb"><view class="content_left_title_1 beyond f-500">{{''+(item.title||'')+''}}</view><view class="content_left_title_2">{{''+(item.item_name||'')+''}}</view></view></view><view class="content_right"><view class="content_right_price">{{'¥'+(item.price||0)+''}}</view><view class="content_right_count">{{'x'+(item.count||0)+''}}</view></view></view></block><view class="store_down" style="margin-right:0rpx;"><view></view><view> 合计：<label class="f-size-32 f-600 _span">{{"¥"+int.order_amount_total}}</label></view></view></view><block wx:if="{{int.order_type==1&&int.status=='2'}}"><view class="box_3"><view class="box_1_top"><u-divider vue-id="fb91a30a-2" text="待使用" bind:__l="__l"></u-divider></view><view class="box_1_title"> 出示「自取码」核销 </view><view class="box_code d-flex a-center"><view class="box_code_left"> 自<view class="_br"></view>取<view class="_br"></view>码<view class="_br"></view></view><view class="box_code_right"><image src="{{int.code}}" mode="widthFix"></image><view class="text_1"> 请向工作人员出示该二维码 </view><view data-event-opts="{{[['tap',[['orderDetailApi',['$event']]]]]}}" class="box_code_right_btn" bindtap="__e"> 手动刷新 </view></view></view></view></block><block wx:if="{{showInstallVisitQr}}"><view class="box_3"><view class="box_1_top"><u-divider vue-id="fb91a30a-3" text="到店安装核销" bind:__l="__l"></u-divider></view><view class="box_1_title"> 请向本店工作人员出示以下二维码，由店员扫码确认您已到店 </view><view class="box_code d-flex a-center"><view class="box_code_left"> 到<view class="_br"></view>店<view class="_br"></view>码<view class="_br"></view></view><view class="box_code_right"><image src="{{int.install_visit_qr}}" mode="widthFix"></image><view class="text_1"> 请勿将二维码发给非本店人员；若无法识别可点刷新 </view><view data-event-opts="{{[['tap',[['orderDetailApi',['$event']]]]]}}" class="box_code_right_btn" bindtap="__e"> 刷新 </view></view></view></view></block><view><order-info vue-id="fb91a30a-4" content_list="{{int}}" bind:__l="__l"></order-info></view><block wx:if="{{$root.m0}}"><view class="install_gallery"><view class="box_3"><view class="box_1_top"><u-divider vue-id="fb91a30a-5" text="安装实拍" bind:__l="__l"></u-divider></view><view class="gal_row"><block wx:for="{{int.install_finish_image_list}}" wx:for-item="img" wx:for-index="ix"><image class="gal_img" src="{{img}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewInstallImg',[ix]]]]]}}" bindtap="__e"></image></block></view></view></view></block><view class="store_down mb-10"><block wx:if="{{int.status==1}}"><view data-event-opts="{{[['tap',[['orderCancelApi',['$0'],['int.id']]]]]}}" class="store_down_right" bindtap="__e"> 取消订单 </view></block><block wx:if="{{int.status==1}}"><view data-event-opts="{{[['tap',[['openpay',['$0'],['int.order_no']]]]]}}" class="store_down_right" style="margin-left:20rpx;" bindtap="__e"> 立即支付 </view></block><block wx:if="{{showConfirmReceiveDetail}}"><view data-event-opts="{{[['tap',[['confirmReceiveDetail',['$event']]]]]}}" class="store_down_right" style="margin-left:20rpx;" bindtap="__e"> 确认收货 </view></block><block wx:if="{{showConfirmInstallDetail}}"><view data-event-opts="{{[['tap',[['confirmInstallDetail',['$event']]]]]}}" class="store_down_right" style="margin-left:20rpx;" bindtap="__e"> 确认安装完成 </view></block><block wx:if="{{showRefundDetail}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="store_down_right" style="margin-left:20rpx;" bindtap="__e"> 申请退款 </view></block></view></view><pay-pop vue-id="fb91a30a-6" orderNo="{{orderNo}}" popShow="{{popShow}}" data-event-opts="{{[['^close',[['e1']]]]}}" bind:close="__e" bind:__l="__l"></pay-pop><refund-pop vue-id="fb91a30a-7" show="{{refundShow}}" data-event-opts="{{[['^comfirm',[['refundApi']]],['^close',[['e2']]]]}}" bind:comfirm="__e" bind:close="__e" bind:__l="__l"></refund-pop></view>