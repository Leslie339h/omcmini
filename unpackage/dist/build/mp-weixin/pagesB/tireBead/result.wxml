<view class="page data-v-ccf0a8f2"><view class="title data-v-ccf0a8f2">识别出的轮胎</view><block wx:if="{{code}}"><view class="code-box data-v-ccf0a8f2"><text class="code-label data-v-ccf0a8f2">识别编号</text><text class="code-value data-v-ccf0a8f2" user-select="{{true}}">{{code}}</text></view></block><block wx:if="{{info}}"><view class="card data-v-ccf0a8f2"><view class="row data-v-ccf0a8f2"><text class="label data-v-ccf0a8f2">子口码</text><text class="value data-v-ccf0a8f2">{{info.bead_code}}</text></view><view class="row data-v-ccf0a8f2"><text class="label data-v-ccf0a8f2">花纹编号</text><text class="value data-v-ccf0a8f2">{{info.pattern_no}}</text></view><view class="row data-v-ccf0a8f2"><text class="label data-v-ccf0a8f2">轮胎规格</text><text class="value data-v-ccf0a8f2">{{info.tire_spec}}</text></view><view class="row data-v-ccf0a8f2"><text class="label data-v-ccf0a8f2">负荷速级</text><text class="value data-v-ccf0a8f2">{{info.load_speed}}</text></view><view class="row last data-v-ccf0a8f2"><text class="label data-v-ccf0a8f2">年周号</text><text class="value data-v-ccf0a8f2">{{info.year_week}}</text></view></view></block><block wx:else><block wx:if="{{loaded}}"><view class="empty data-v-ccf0a8f2">未在数据库中匹配到该子口码</view></block><block wx:else><view class="empty data-v-ccf0a8f2">查询中...</view></block></block><view class="btn-wrap data-v-ccf0a8f2"><view data-event-opts="{{[['tap',[['rescan',['$event']]]]]}}" class="btn data-v-ccf0a8f2" bindtap="__e">再次扫描</view></view></view>