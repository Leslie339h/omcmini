page{background:linear-gradient(145deg,#0cb080,#66cdaf 56%,#ecf7f5 97%)}.group_1{font-weight:400;font-size:32rpx;color:#fff;text-align:center}.group_2{font-weight:900;font-size:120rpx;color:#fff;text-align:center;margin:0rpx 0 20rpx}.group_3{width:352rpx;height:88rpx;background:#fff;opacity:.8;border-radius:334rpx;font-weight:400;font-size:40rpx;color:#3d3d3d;line-height:88rpx;text-align:center;margin:0 auto}.group_4{width:690rpx;height:60vh;background:linear-gradient(180deg,#ffedd8,#fff);border-radius:34rpx 34rpx 34rpx 34rpx;margin:40rpx auto 0;padding:50rpx;box-sizing:border-box}.group_4 .group_4_title{font-size:36rpx;color:#3d3d3d;font-weight:600}.scroll_box{height:calc(60vh - 150rpx)}.scroll_box .scroll_box_item{margin-bottom:20rpx}.scroll_box .scroll_box_item .scroll_box_item_img{width:90rpx;height:108rpx}.scroll_box .scroll_box_item .scroll_box_item_right{padding:8rpx 0;box-sizing:border-box;width:calc(100% - 120rpx);height:108rpx}