page{background:#fafafa}.wallet_box{height:100vh;display:flex;flex-direction:column}.wallet_box .card{background:#fff;padding:0rpx 0 20rpx;box-sizing:border-box;width:700rpx;margin:30rpx auto 0;border-radius:0rpx 0rpx 30rpx 30rpx}.wallet_box .card .tix{width:184rpx;height:70rpx;border-radius:30rpx 0 0 30rpx;position:absolute;top:250rpx;right:20rpx;background-color:#fff;font-size:28rpx;color:#036045;text-align:center;line-height:70rpx}.wallet_box .card .head{position:absolute;top:60rpx;left:80rpx;color:#fff;font-size:34rpx;line-height:60rpx}.wallet_box .card .head image{width:60rpx;height:60rpx;margin-right:20rpx;border-radius:50%}.wallet_box .card .text{font-size:28rpx;color:#fff;position:absolute;top:260rpx;left:80rpx}.wallet_box .card .money{font-size:50rpx;color:#fff;position:absolute;top:168rpx;left:80rpx}.wallet_box .card .wellet{width:700rpx;height:350rpx}.wallet_box .card .shouyi{padding:20rpx 60rpx 0;box-sizing:border-box}.wallet_box .card .yield .one{font-size:24rpx;color:#777;margin-right:20rpx}.wallet_box .card .yield .two{font-size:24rpx;color:#036045}.wallet_box .detail{width:699rpx;background:#fff;border-radius:20rpx 20rpx 20rpx 20rpx;margin:40rpx auto}.wallet_box .detail .title{font-size:36rpx;color:#333;font-weight:600;padding:30rpx 40rpx;box-sizing:border-box}.wallet_box .detail .btn{width:169rpx;background:#f1f2f2;border-radius:34rpx;font-size:24rpx;color:#777;text-align:center;line-height:60rpx}.wallet_box .detail .content{padding:0 40rpx 40rpx;box-sizing:border-box}.wallet_box .detail .content .item{padding:24rpx 0;border-bottom:1rpx solid #ebebeb}.wallet_box .detail .content .item .right{font-size:30rpx;color:#036045;text-align:right}.wallet_box .detail .content .item .item_left image{width:80rpx;height:80rpx;border-radius:50%;margin-right:20rpx}.wallet_box .detail .content .item .item_left .top{font-size:32rpx;color:#333}.wallet_box .detail .content .item .item_left .bom{font-size:24rpx;color:#777}