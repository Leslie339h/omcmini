page{padding:0 30rpx 180rpx;background-color:#f4f5f7;box-sizing:border-box}.box{display:grid;grid-template-columns:repeat(2,336rpx);row-gap:20rpx;justify-content:space-between}.box .box_item{width:336rpx;height:280rpx;background:#fff;border-radius:20rpx 20rpx 20rpx 20rpx}.box .box_item .box_item_bom{padding:10rpx 22rpx;box-sizing:border-box}.box .box_item .img_1{width:336rpx;height:162rpx;border-radius:20rpx 20rpx 0rpx 0rpx}.box .box_item .img_box image{width:24rpx;height:24rpx}.head{background-color:#f4f5f7;padding:30rpx 0 20rpx;box-sizing:border-box}.head .head_right{width:166rpx;height:50rpx;background:#036045;border-radius:10rpx;font-size:26rpx;color:#fff;line-height:50rpx;text-align:center}.fixed{padding:22rpx 38rpx 38rpx;box-sizing:border-box;background-color:#fff;position:fixed;bottom:0;left:0;right:0;color:#fff}.fixed .fixed_btn{height:90rpx;background:#232323;border-radius:1246rpx 1246rpx 1246rpx 1246rpx}.fixed .fixed_btn .fixed_btn_left{font-weight:400;font-size:40rpx;color:#fff}.fixed .fixed_btn .fixed_btn_right{width:300rpx;height:90rpx;background:#036045;border-radius:1246rpx 1246rpx 1246rpx 1246rpx;font-weight:400;font-size:30rpx;color:#fff;line-height:90rpx;text-align:center}