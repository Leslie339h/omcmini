page{background-color:#fafafa;padding-bottom:100rpx}.title{width:701rpx;height:160rpx;background:#fff;border-radius:22rpx;margin:-20rpx auto 0;position:relative;z-index:10}.title .title_top{font-size:32rpx;font-weight:600;color:#333;text-indent:1em;padding:20rpx 0}.title .title_bottom{display:flex;align-items:center;justify-content:space-between;padding:0 30rpx}.title .title_bottom text:nth-child(1){font-size:32rpx;font-weight:600;color:#05b6f6;line-height:50rpx}.title .title_bottom text:nth-child(2){font-size:24rpx;font-weight:400;color:#9f9f9f}.content_text{width:701rpx;margin:30rpx auto;background:#fff;border-radius:22rpx;padding:30rpx;box-sizing:border-box}.btn{width:100%;height:143rpx;background:#fff;position:fixed;bottom:0}.btn .btn_text{width:701rpx;height:88rpx;background:#05b6f6;border-radius:44rpx;margin:20rpx auto;font-size:26rpx;font-weight:400;color:#fff;line-height:88rpx;text-align:center}