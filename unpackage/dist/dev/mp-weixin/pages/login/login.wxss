page {
  min-height: 100vh;
  background-color: #FFFFFF;
}
 button {
  width: 96rpx;
  height: 96rpx;
  background-color: transparent;
  padding: 0;
}
 button image {
  width: 96rpx;
  height: 96rpx;
}
.xz_box .bg_1 {
  width: 50rpx;
}
.xz_box .xzquan {
  width: 50rpx;
  height: 50rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  box-sizing: border-box;
  background-color: #fff;
}
.box {
  margin: -40rpx 0 0;
  position: relative;
  z-index: 9;
  background-color: #FFFFFF;
  border-radius: 60rpx 60rpx 0rpx 0rpx;
  padding: 94rpx 60rpx 0;
  box-sizing: border-box;
}
.box .box_title {
  font-weight: 600;
  font-size: 42rpx;
  color: #1C1C1C;
  text-align: center;
}
.box .base_quick {
  margin-top: 48rpx;
}
.box .base_tip {
  text-align: center;
  font-size: 26rpx;
  color: #9A9A9A;
  margin-bottom: 48rpx;
}
.box .base_agree {
  padding-bottom: 60rpx;
}
.box .base_img {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
}
.box .radio {
  width: 543rpx;
}
.box .radio text:nth-child(1) {
  font-size: 24rpx;
  font-weight: 400;
  color: #9A9A9A;
}
.box .radio text:nth-child(2) {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A94FF;
}
.box .radio text:nth-child(3) {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A94FF;
}
.box .radio text:nth-child(4) {
  font-size: 24rpx;
  font-weight: 400;
  color: #9A9A9A;
}
.box .radio text:nth-child(5) {
  font-size: 24rpx;
  font-weight: 400;
  color: #4A94FF;
}
.box_up {
  width: 578rpx;
  height: 398rpx;
  padding: 36rpx 28rpx 0;
  box-sizing: border-box;
}
.box_up .box_up_title {
  font-weight: 400;
  font-size: 32rpx;
  color: #3D3D3D;
  text-align: center;
}
.box_up .box_up_radio {
  width: 522rpx;
  margin: 26rpx auto 78rpx;
  font-size: 28rpx;
  color: #999999;
}
.box_up .box_up_btn_1 {
  width: 196rpx;
  height: 66rpx;
  border-radius: 972rpx 972rpx 972rpx 972rpx;
  border: 2rpx solid #999999;
  font-weight: 400;
  font-size: 28rpx;
  color: #999999;
  line-height: 66rpx;
  text-align: center;
}
.box_up .box_up_btn_2 {
  width: 196rpx;
  height: 66rpx;
  border-radius: 972rpx 972rpx 972rpx 972rpx;
  border: 2rpx solid #999999;
  background: #214B3D;
  font-weight: 400;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 66rpx;
  text-align: center;
}
.head_img {
  width: 100%;
  height: 430rpx;
}
.text_box {
  font-size: 60rpx;
  position: absolute;
  bottom: 6vh;
  left: 38rpx;
}
.text_box .text_box_btn {
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx 40rpx 40rpx 4rpx;
  font-weight: 900;
  font-size: 36rpx;
  color: #22A779;
  line-height: 62rpx;
  text-align: center;
}
.close {
  position: absolute;
  top: 6vh;
  left: 38rpx;
}

