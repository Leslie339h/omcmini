page {
  background-color: #F4F5F7;
}
.label {
  min-width: 120rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 2rpx;
  border: 1rpx solid #036045;
  font-size: 24rpx;
  font-weight: 500;
  color: #036045;
  line-height: 38rpx;
  text-align: center;
}
.content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.content .content_left .content_left_1 {
  font-size: 32rpx;
  font-weight: 400;
  color: #393939;
}
.content .content_left .content_left_2 {
  font-size: 24rpx;
  font-weight: 400;
  color: #979797;
}
.content .content_right {
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.content .content_right .content_right_1 {
  width: 66rpx;
  height: 66rpx;
}
.content .content_right .content_right_2 {
  width: 66rpx;
  height: 66rpx;
}
.line {
  padding: 0rpx 0 8rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #eee;
}
.head {
  width: 750rpx;
  background: #FFFFFF;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  padding: 0rpx 10rpx 10rpx;
  box-sizing: border-box;
}
.install_tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f0f7f4;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #5a6b66;
  line-height: 1.45;
}
.box_2 .store {
  width: 660rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  margin: 20rpx auto;
  padding: 22rpx 20rpx 10rpx;
}
.box_2 .store_down {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  box-sizing: border-box;
  margin-top: 20rpx;
}
.box_2 .store_down .store_down_right {
  min-width: 180rpx;
  height: 82rpx;
  padding: 0 16rpx;
  background: #036045;
  border-radius: 41rpx;
  color: #FFFFFF;
  line-height: 82rpx;
  text-align: center;
  font-size: 26rpx;
}
.box_2 .content_detail {
  display: flex;
  justify-content: space-between;
  padding: 25rpx 0 0;
}
.box_2 .content_detail .content_left {
  display: flex;
}
.box_2 .content_detail .content_left .content_left_img {
  width: 106rpx;
  height: 106rpx;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
}
.box_2 .content_detail .content_left .content_left_img image {
  width: 106rpx;
  height: 106rpx;
  border-radius: 10rpx;
}
.box_2 .content_detail .content_left .content_left_title {
  margin-left: 10rpx;
  width: 300rpx;
}
.box_2 .content_detail .content_left .content_left_title .content_left_title_1 {
  font-size: 28rpx;
  font-weight: 400;
  color: #353535;
}
.box_2 .content_detail .content_left .content_left_title .content_left_title_2 {
  font-size: 24rpx;
  font-weight: 400;
  color: #989898;
  margin: 4rpx 0;
}
.box_2 .content_detail .content_right {
  text-align: right;
}
.box_2 .content_detail .content_right .content_right_price {
  font-size: 32rpx;
  font-weight: 400;
  color: #353535;
}
.box_2 .content_detail .content_right .content_right_count {
  font-size: 24rpx;
  font-weight: 400;
  color: #989898;
  margin-top: 10rpx;
}

