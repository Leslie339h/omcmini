page {
  background: #F8F8F8;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}
.store_block {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}
.store_title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.store_scroll {
  max-height: 520rpx;
}
.store_row {
  padding: 22rpx 20rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}
.store_row.active {
  border-color: #036045;
  background: #f0faf6;
}
.defer_store_row {
  padding: 22rpx 20rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.defer_store_row.active {
  border-color: #036045;
  background: #f0faf6;
}
.store_tag {
  font-size: 22rpx;
  color: #036045;
  border: 1rpx solid #036045;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.card_3 {
  font-weight: 400;
  font-size: 26rpx;
  color: #313131;
  line-height: 36rpx;
  padding: 26rpx 22rpx;
  box-sizing: border-box;
  background-color: #fff;
  background: #FFFFFF;
  border-radius: 20rpx 20rpx 20rpx 20rpx;
}
.card_3.coupon_row {
  margin-bottom: 24rpx;
}
.coupon_popup {
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}
.coupon_popup .coupon_popup_title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}
.coupon_popup .coupon_popup_scroll {
  max-height: 60vh;
}
.coupon_popup .coupon_popup_row {
  padding: 24rpx 20rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #fafafa;
}
.coupon_popup .coupon_popup_row.active {
  border-color: #036045;
  background: #f0faf6;
}
.coupon_popup .coupon_check {
  font-size: 32rpx;
  color: #036045;
  flex-shrink: 0;
}
.coupon_popup .coupon_popup_empty {
  text-align: center;
  padding: 40rpx 0;
}
.option {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.card_2 {
  margin: 28rpx 0;
  padding: 20rpx;
  box-sizing: border-box;
  width: 703rpx;
  background: #FFFFFF;
  border-radius: 18rpx 18rpx 18rpx 18rpx;
}
.card_2 .card_2_box .card_2_box_img {
  border-radius: 10rpx;
  border: 1rpx solid #eee;
  width: 103rpx;
  height: 106rpx;
}
.card_2 .card_2_box .card_2_box_center {
  width: 450rpx;
}
.card_2 .card_2_price {
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #eee;
  font-weight: 600;
}
.fiexed {
  background-color: #fff;
  width: 750rpx;
  height: 127rpx;
  background: #FFFFFF;
  border-radius: 8rpx 8rpx 0rpx 0rpx;
  padding: 22rpx;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}
.fiexed .fiexed_btn {
  width: 207rpx;
  height: 82rpx;
  background: #036045;
  border-radius: 41rpx;
  font-size: 28rpx;
  color: #F6FCFF;
  line-height: 82rpx;
  text-align: center;
}

