.active {
  background: rgba(3, 96, 69, 0.1) !important;
}
.box_1 {
  padding: 30rpx;
  box-sizing: border-box;
}
.box_1 .box_1_top {
  font-weight: 600;
  font-size: 30rpx;
  color: #060606;
}
.box_1 .box_1_top .box_1_top_left .tag {
  width: 108rpx;
  height: 40rpx;
  background: url(data:image/png;base64,) no-repeat;
  background-size: 100% 100%;
  font-weight: 400;
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 40rpx;
  text-align: center;
  margin-left: 10rpx;
}
.box_1 .box_1_top .box_1_top_right image {
  width: 30rpx;
  height: 30rpx;
}
.box_1 .box_1_bom {
  font-weight: 400;
  color: #676767;
}
.box_1 .box_1_bom image {
  width: 19rpx;
  height: 22rpx;
}
.box_1 .box_1_bom .img_1 {
  width: 19rpx;
}
.search_box {
  width: 690rpx;
  height: 76rpx;
  background: #F6F7FB;
  border-radius: 152rpx 152rpx 152rpx 152rpx;
  margin: 20rpx auto;
  padding: 0 36rpx;
  box-sizing: border-box;
}
.search_box .search_box_left {
  padding-right: 30rpx;
  border-right: 2rpx solid #666666;
}
.search_box .search_box_left image {
  width: 18rpx;
  height: 10rpx;
  margin-left: 10rpx;
}
.search_box .search_box_right {
  margin-left: 20rpx;
}
.search_box .search_box_right image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
}
.search_box .search_box_right input {
  width: 400rpx;
}
.fixed {
  padding: 28rpx;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-top: 1rpx solid #eee;
  z-index: 9;
  background-color: #fff;
}
.fixed .fixed_btn {
  width: 672rpx;
  height: 78rpx;
  background: #036045;
  border-radius: 772rpx 772rpx 772rpx 772rpx;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  line-height: 78rpx;
}

