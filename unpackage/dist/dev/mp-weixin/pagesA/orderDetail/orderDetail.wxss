page {
  background: #F4F5F7;
  padding: 0 0 50rpx;
}
.install_tip_detail {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #f0f7f4;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #5a6b66;
  line-height: 1.5;
}
.store_down {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  margin: 30rpx 30rpx 0 0;
}
.store_down .store_down_left {
  width: 207rpx;
  height: 82rpx;
  background: #232323;
  border-radius: 41rpx;
  color: #FFFFFF;
  line-height: 82rpx;
  text-align: center;
  margin-right: 24rpx;
}
.store_down .store_down_right {
  width: 207rpx;
  height: 82rpx;
  background: #036045;
  border-radius: 41rpx;
  color: #FFFFFF;
  line-height: 82rpx;
  text-align: center;
}
.order_status_head {
  width: 703rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  margin: 20rpx auto 0;
  align-items: center;
  justify-content: space-between;
}
.order_status_head_left {
  color: #333333;
}
.order_status_head_right {
  font-weight: 500;
  text-align: right;
  max-width: 420rpx;
}
.color-03 {
  color: #036045;
}
.box_1 {
  width: 703rpx;
  background: #FFFFFF;
  border-radius: 18rpx 18rpx 18rpx 18rpx;
  padding: 22rpx 42rpx;
  box-sizing: border-box;
  margin: 20rpx auto 0;
}
.box_2 .store {
  width: 702rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  margin: 20rpx auto;
  padding: 32rpx 20rpx;
}
.box_2 .addBtn {
  width: 100%;
  height: 31rpx;
  font-weight: 400;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}
.box_2 .content_detail {
  display: flex;
  justify-content: space-between;
  padding: 25rpx 0 0;
}
.box_2 .content_detail .content_left {
  display: flex;
}
.box_2 .content_detail .content_left .content_left_img {
  width: 103rpx;
  height: 106rpx;
  margin-right: 16rpx;
}
.box_2 .content_detail .content_left .content_left_img image {
  width: 103rpx;
  height: 106rpx;
  border-radius: 8rpx;
}
.box_2 .content_detail .content_left .content_left_title {
  margin-left: 10rpx;
}
.box_2 .content_detail .content_left .content_left_title .content_left_title_1 {
  width: 400rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #353535;
}
.box_2 .content_detail .content_left .content_left_title .content_left_title_2 {
  width: 400rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #989898;
  margin: 4rpx 0;
}
.box_2 .content_detail .content_right {
  text-align: right;
}
.box_2 .content_detail .content_right .content_right_price {
  font-size: 32rpx;
  font-weight: 400;
  color: #353535;
}
.box_2 .content_detail .content_right .content_right_count {
  font-size: 24rpx;
  font-weight: 400;
  color: #989898;
  margin-top: 10rpx;
}
.box_3 {
  width: 702rpx;
  background: #FFFFFF;
  border-radius: 12rpx 12rpx 12rpx 12rpx;
  margin: 28rpx auto;
  padding: 10rpx 30rpx 30rpx;
  box-sizing: border-box;
}
.box_3 .box_code {
  width: 622rpx;
  height: 468rpx;
  background: #F4F5F7;
  border-radius: 18rpx 18rpx 18rpx 18rpx;
  margin-top: 28rpx;
}
.box_3 .box_code .box_code_left {
  width: 68rpx;
  height: 468rpx;
  background: #232323;
  border-radius: 18rpx 18rpx 18rpx 18rpx;
  font-weight: 400;
  font-size: 28rpx;
  color: #FFFFFF;
  padding-top: 180rpx;
  text-align: center;
}
.box_3 .box_code .box_code_right_btn {
  width: 136rpx;
  height: 46rpx;
  background: #F9FCFE;
  border-radius: 19rpx 19rpx 19rpx 19rpx;
  font-size: 22rpx;
  color: #036045;
  line-height: 46rpx;
  text-align: center;
  margin: 0 auto;
}
.box_3 .box_code .box_code_right {
  text-align: center;
  width: calc(100% - 68rpx);
}
.box_3 .box_code .box_code_right image {
  width: 280rpx;
  height: 278rpx;
  background: #D8D8D8;
}
.box_3 .box_code .box_code_right .text_1 {
  font-weight: 400;
  font-size: 22rpx;
  color: #0A0A0A;
  text-align: center;
  margin: 20rpx 0;
}
.box_3 .box_1_top {
  margin: 0 auto;
  width: 300rpx;
}
.box_3 .box_1_title {
  font-weight: 600;
  font-size: 28rpx;
  color: #3D3D3D;
}
.gal_row {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 0 0;
  gap: 16rpx;
}
.gal_row .gal_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

