page {
  padding: 0 30rpx;
  box-sizing: border-box;
  background-color: #fff;
}
.bg_1 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100vw;
  height: 358rpx;
}
.box {
  width: 690rpx;
  height: 230rpx;
  background: #3E75FE;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  margin: 30rpx auto 0;
  padding: 36rpx 46rpx 52rpx;
  box-sizing: border-box;
  position: relative;
}
.box .bg_2 {
  position: absolute;
  right: 0;
  top: 0;
  width: 240rpx;
  height: 240rpx;
}
.box-1 {
  display: grid;
  grid-template-columns: repeat(3, 32%);
  row-gap: 20rpx;
  justify-content: space-between;
}
.box-1 .active {
  background: #E6F2FF !important;
  border: 5rpx solid #2966FF !important;
}
.box-1 .box_1_item {
  padding: 34rpx 26rpx 0;
  box-sizing: border-box;
  width: 208rpx;
  height: 192rpx;
  background: #F5F7F9;
  border-radius: 31rpx 31rpx 31rpx 31rpx;
  border: 5rpx solid #E8EBEA;
}
.btn {
  width: 701rpx;
  height: 101rpx;
  background: #2966FF;
  border-radius: 51rpx 51rpx 51rpx 51rpx;
  font-weight: 400;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 101rpx;
  text-align: center;
  margin-top: 50rpx;
}

