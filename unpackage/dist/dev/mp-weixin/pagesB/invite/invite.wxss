page {
  background-color: #EFF1F3;
  padding: 30rpx;
  box-sizing: border-box;
}
.bg_img {
  width: 100vw;
  height: 1010rpx;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: -1;
  background: linear-gradient(to top, #EFF1F3, #49A187, #66CDAF);
}
.user image {
  width: 60rpx;
  height: 60rpx;
  background: #D8D8D8;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}
.card_1 {
  width: 690rpx;
  height: 156rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 14rpx 14rpx;
  margin: 20rpx auto;
  padding: 34rpx;
  box-sizing: border-box;
}
.card_1 .card_1_item {
  width: 50%;
}
.card_2 {
  width: 690rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 34rpx;
  box-sizing: border-box;
}
.card_2 .card_btn {
  width: 636rpx;
  height: 102rpx;
  background: linear-gradient(90deg, #036045 0%, #66CDAF 100%);
  border-radius: 1246rpx 1246rpx 1246rpx 1246rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  text-align: center;
  line-height: 102rpx;
  margin-top: 44rpx;
}
.tool {
  margin: 76rpx auto 26rpx;
  height: 45rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #000002;
}
.tool_class {
  background: #FFFFFF;
  border-radius: 14rpx;
  padding-top: 20rpx;
  padding-bottom: 10rpx;
}
.tool_class_box {
  width: 90%;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.tool_class_box_conten {
  display: flex;
  align-items: center;
  width: 50%;
  height: 70rpx;
  margin-bottom: 50rpx;
}
.tool_class_box_conten_right {
  margin-left: 20rpx;
}
.tool_class_box_conten_right_top {
  font-size: 26rpx;
  font-weight: 400;
  color: #000002;
}
.tool_class_box_conten_right_bottom {
  font-size: 24rpx;
  font-weight: 400;
  color: #95959E;
  line-height: 33rpx;
}

