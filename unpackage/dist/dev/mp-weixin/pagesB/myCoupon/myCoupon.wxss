page {
  background: #F4F5F7;
}
.bg_img {
  height: 682rpx;
  width: 100vw;
}
.box_1 {
  padding: 30rpx;
  box-sizing: border-box;
  background: #F4F5F7;
  border-radius: 30rpx;
  margin-top: -50rpx;
  position: relative;
  z-index: 9;
  padding: 30rpx;
  box-sizing: border-box;
}
.box_1 .box_1_item {
  margin-top: 30rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  position: relative;
}
.box_1 .box_1_item .box_1_item_top {
  padding: 10rpx 20rpx 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F6F6F6;
}
.box_1 .box_1_item .box_1_item_bom {
  padding: 30rpx 0 0;
  box-sizing: border-box;
}
.box_1 .box_1_item .box_1_item_bom .box_1_item_bom_btn {
  color: #fff;
  text-align: center;
  line-height: 58rpx;
  width: 151rpx;
  height: 58rpx;
  background: #036045;
  border-radius: 29rpx;
}
.box_1 .box_1_item .box_1_item_bom .box_1_item_bom_left {
  padding-top: 10rpx;
  box-sizing: border-box;
  font-weight: 400;
  font-size: 22rpx;
  color: #343434;
}
.box_1 .box_1_item .box_1_item_bom .box_1_item_bom_left image {
  width: 33rpx;
  height: 33rpx;
  margin-left: 10rpx;
}
.box_1 .box_1_item .box_1_item_bom .box_1_item_bom_left .box_1_item_bom_card {
  position: absolute;
  bottom: -160rpx;
  left: 0;
  z-index: 9;
  width: 299rpx;
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.1331);
  border-radius: 8rpx 8rpx 8rpx 8rpx;
  padding: 0rpx 24rpx;
  box-sizing: border-box;
}
.box_1 .box_1_item .box_1_item_bom .box_1_item_bom_left .box_1_item_bom_card .box_1_item_bom_card_item {
  font-size: 22rpx;
  color: #101010;
  margin: 18rpx 0;
}
.arrowLeft {
  position: absolute;
  left: 30rpx;
  top: 100rpx;
  z-index: 9;
}

