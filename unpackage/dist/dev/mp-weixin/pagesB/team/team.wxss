page {
  background: #F5F7FB;
  padding: 30rpx;
  box-sizing: border-box;
}
.box_1 .box_1_left {
  padding: 32rpx 34rpx;
  box-sizing: border-box;
  width: 280rpx;
  height: 272rpx;
  background: #739AFF;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  position: relative;
}
.box_1 .box_1_left image {
  width: 146rpx;
  height: 146rpx;
  position: absolute;
  bottom: 0;
  right: 0;
}
.box_1 .box_1_right .box_1_right_bom .box_1_right_bom_1 {
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  background: #32D3EB;
  width: 174rpx;
  height: 128rpx;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
}
.box_1 .box_1_right .box_1_right_bom .box_1_right_bom_2 {
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  background: #C5B9EC;
  width: 174rpx;
  height: 128rpx;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
}
.box_1 .box_1_right .box_1_right_top {
  width: 372rpx;
  height: 128rpx;
  background: #65D4C8;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
  position: relative;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.box_1 .box_1_right .box_1_right_top image {
  width: 124rpx;
  height: 108rpx;
  position: absolute;
  bottom: 0;
  right: 0;
}
.box_2 {
  width: 690rpx;
  background: #FFFFFF;
  padding: 30rpx 22rpx;
  border-radius: 16rpx 16rpx 16rpx 16rpx;
}
.box_2 .box_2_ipts .box_2_ipts_item {
  padding: 10rpx 20rpx;
  border-radius: 14rpx 14rpx 14rpx 14rpx;
  border: 1rpx solid #999999;
  font-size: 24rpx;
  color: #3D3D3D;
  margin-right: 20rpx;
}
.box_2 .box_2_ipts .box_2_ipts_item image {
  width: 16rpx;
  height: 12rpx;
  margin-left: 10rpx;
}
.box_3 {
  background: #fff;
  border-radius: 40rpx;
  box-sizing: border-box;
  padding: 28rpx 22rpx;
}
.box_3 .box_1_item {
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.box_3 .box_1_item .box_1_item_left .box_1_item_left_user {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.box_3 .box_1_item .box_1_item_left .box_1_item_left_text {
  font-size: 28rpx;
  font-weight: 600;
  color: #232323;
}
.box_3 .box_1_item .box_1_item_left .box_1_item_left_text_1 {
  font-size: 24rpx;
  color: #666666;
}
.box_3 .box_1_item .box_1_item_right {
  width: 142rpx;
  height: 52rpx;
  border-radius: 1314rpx 1314rpx 1314rpx 1314rpx;
  border: 2rpx solid #036045;
  font-size: 24rpx;
  color: #036045;
  line-height: 52rpx;
  text-align: center;
}
.box_1_head {
  background: #FEFEFE;
  font-weight: 400;
  font-size: 32rpx;
  color: #3D3D3D;
  margin-bottom: 30rpx;
}
.box_1_head .finally_1_2_img {
  height: 35rpx;
  display: flex;
  flex-direction: column;
  margin-left: 10rpx;
}
.box_1_head .finally_1_2_img image {
  width: 20rpx;
  height: 30rpx;
}

