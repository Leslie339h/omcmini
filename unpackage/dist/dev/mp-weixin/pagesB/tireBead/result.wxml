<view class="page data-v-4b1e439b"><view class="title data-v-4b1e439b">识别出的轮胎</view><block wx:if="{{code}}"><view class="code-box data-v-4b1e439b"><text class="code-label data-v-4b1e439b">识别编号</text><text class="code-value data-v-4b1e439b" user-select="{{true}}">{{code}}</text></view></block><block wx:if="{{info}}"><view class="card data-v-4b1e439b"><view class="row data-v-4b1e439b"><text class="label data-v-4b1e439b">子口码</text><text class="value data-v-4b1e439b">{{info.bead_code}}</text></view><view class="row data-v-4b1e439b"><text class="label data-v-4b1e439b">花纹编号</text><text class="value data-v-4b1e439b">{{info.pattern_no}}</text></view><view class="row data-v-4b1e439b"><text class="label data-v-4b1e439b">轮胎规格</text><text class="value data-v-4b1e439b">{{info.tire_spec}}</text></view><view class="row data-v-4b1e439b"><text class="label data-v-4b1e439b">负荷速级</text><text class="value data-v-4b1e439b">{{info.load_speed}}</text></view><view class="row last data-v-4b1e439b"><text class="label data-v-4b1e439b">年周号</text><text class="value data-v-4b1e439b">{{info.year_week}}</text></view></view></block><block wx:else><block wx:if="{{loaded}}"><view class="empty data-v-4b1e439b">未在数据库中匹配到该子口码</view></block><block wx:else><view class="empty data-v-4b1e439b">查询中...</view></block></block><view class="btn-wrap data-v-4b1e439b"><view data-event-opts="{{[['tap',[['rescan',['$event']]]]]}}" class="btn data-v-4b1e439b" bindtap="__e">再次扫描</view></view></view>