.bg_img {
  width: 100vw;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
}
.box {
  width: 690rpx;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 40rpx 40rpx;
  margin: 100rpx auto 0;
  padding-bottom: 50rpx;
}
.box .box_1 {
  padding: 46rpx 52rpx 20rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eee;
}
.box .box_1 image {
  width: 106rpx;
  height: 106rpx;
  border-radius: 50%;
}
.box .code_img {
  width: 400rpx;
  text-align: center;
}
.box .btn_1 {
  width: 632rpx;
  height: 84rpx;
  background: #036045;
  border-radius: 566rpx;
  font-weight: 400;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 84rpx;
  margin: 36rpx auto 0;
  text-align: center;
}
.box .btn_2 {
  margin: 36rpx auto 0;
  width: 632rpx;
  height: 84rpx;
  background: #232323;
  border-radius: 566rpx;
  font-weight: 400;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 84rpx;
  text-align: center;
}

