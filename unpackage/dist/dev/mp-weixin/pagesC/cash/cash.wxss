.add {
  padding: 34rpx 40rpx;
  box-sizing: border-box;
  margin-right: 20rpx;
  border-top: 1rpx solid #E4E4E4;
}
.add .left {
  line-height: 90rpx;
}
.add .left image {
  width: 90rpx;
  height: 90rpx;
}
.popItem {
  padding: 24rpx 40rpx;
  box-sizing: border-box;
  margin-right: 20rpx;
  border-top: 1rpx solid #f3f3f3;
}
.popItem .head {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.popItem .left .name {
  font-size: 32rpx;
  color: #333333;
  margin: 0 0 10rpx 20rpx;
  line-height: 80rpx;
}
.popItem .left .img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  text-align: center;
  line-height: 80rpx;
}
.popItem .left .phone {
  font-size: 28rpx;
  color: #777777;
}
.popItem .right {
  line-height: 100rpx;
}
.popItem .right image {
  width: 40rpx;
  height: 40rpx;
}
.popTitle {
  text-align: center;
  margin: 40rpx 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}
page {
  background: #FAFAFA;
}
.qrBtn {
  width: 700rpx;
  height: 98rpx;
  background: #036045;
  border-radius: 14rpx;
  text-align: center;
  line-height: 98rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  margin: 60rpx auto 40rpx;
}
.content {
  width: 700rpx;
  box-sizing: border-box;
  padding: 24rpx 26rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #777777;
  line-height: 42rpx;
  margin: 0 auto;
}
.rules-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}
.rules-detail-link {
  color: #036045;
  text-align: right;
  margin-top: 8rpx;
}
.rules-top {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  width: 700rpx;
  margin: 20rpx auto 0;
  color: #036045;
  font-size: 26rpx;
}
.navbar {
  padding: 122rpx 50rpx 30rpx;
  box-sizing: border-box;
  background-color: #fff;
}
.card {
  width: 700rpx;
  height: 122rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  margin: 20rpx auto;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}
.card image {
  width: 30rpx;
  height: 30rpx;
}
.card_one {
  width: 700rpx;
  height: 296rpx;
  background: #FFFFFF;
  border-radius: 14rpx;
  margin: 0 auto;
  padding: 32rpx 25rpx;
  box-sizing: border-box;
}
.card_one .top {
  font-size: 28rpx;
  color: #2F3337;
}
.card_one .center {
  border-bottom: 1rpx solid #EBEBEB;
  padding: 22rpx 0;
  box-sizing: border-box;
  margin: 30rpx 0;
}
.card_one .center .one {
  font-size: 40rpx;
  color: #2F3337;
  margin-right: 16rpx;
}
.card_one .center .two {
  width: 300rpx;
  height: 50rpx;
  font-size: 48rpx;
  color: #2F3337;
}
.card_one .center .thr {
  font-size: 26rpx;
  color: #036045;
  margin-top: 10rpx;
}
.card_one .bom {
  font-size: 24rpx;
  color: #777777;
}

