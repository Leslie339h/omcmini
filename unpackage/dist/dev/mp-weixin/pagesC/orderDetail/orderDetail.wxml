<view hidden="{{!(pageShow)}}" style="padding-bottom:120rpx;"><block wx:if="{{detail.user}}"><view class="card"><view class="user flexc flexs"><view class="left flexc"><image src="{{detail.user.avatar}}" mode="aspectFill"></image><view style="line-height:64rpx;">{{''+detail.user.nickname+''}}</view></view><view class="right"><image src="../static/cicon16.png" mode data-event-opts="{{[['tap',[['openTel',['$0'],['detail.user.mobile']]]]]}}" bindtap="__e"></image></view></view><block wx:if="{{$root.g0}}"><view class="mt-30 f-size-28">{{'退款原因: '+detail.refund.apply+''}}</view></block></view></block><view class="order_details"><view class="card_one flexs flexc"><view class="f-bold f-size-36">{{''+detail.order_type_text+'订单'}}</view><view class="right"><text>{{detail.status_text+''}}</text></view></view><view class="card_two flexs flexc"><view class="left">配送方式：</view><view class="right">{{detail.order_type_text}}</view></view><view class="card_three"><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 下单时间： </view><view class="right">{{''+detail.createtime+''}}</view></view><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 订单编号： </view><view class="right">{{''+detail.order_no+''}}</view></view><block wx:if="{{detail.pay_time}}"><view class="item flexs flexc"><view class="left"> 支付时间： </view><view class="right">{{''+detail.pay_time+''}}</view></view></block><block wx:if="{{detail.subscribe_time_text}}"><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 预约时间： </view><view class="right">{{''+detail.subscribe_time_text+''}}</view></view></block><block wx:if="{{detail.dd_time_text}}"><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 到店/安装时间： </view><view class="right">{{''+detail.dd_time_text+''}}</view></view></block><block wx:if="{{detail.store_receive_time_text}}"><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 门店确认收货： </view><view class="right">{{''+detail.store_receive_time_text+''}}</view></view></block><block wx:if="{{detail.store_confirm_user_time_text}}"><view class="item flexs flexc" style="border-bottom:1rpx solid #EBEBEB;"><view class="left"> 确认到店/可安装： </view><view class="right">{{''+detail.store_confirm_user_time_text+''}}</view></view></block><block wx:if="{{detail.user_install_finish_time_text}}"><view class="item flexs flexc"><view class="left"> 用户确认完成： </view><view class="right">{{''+detail.user_install_finish_time_text+''}}</view></view></block></view><view style="background-color:#fff;border-radius:20rpx;padding-bottom:20rpx;"><view class="card_four"><view class="title"> 商品明细 </view><view><block wx:for="{{detail.detail}}" wx:for-item="item" wx:for-index="__i0__" wx:key="*this"><view class="shop flexc"><image src="{{item.image}}" mode="aspectFill"></image><view class="shop_item"><view class="flexs one"><view class="me-text-beyond">{{item.title}}</view><view>{{"¥"+item.price}}</view></view><view class="two">{{''+item.item_name+''}}</view><view class="three">{{'×'+item.count+''}}</view></view></view></block></view></view></view><view class="card_five"><view class="left f-size-32 f-bold">备注：</view><view class="right mt-10">{{detail.remark||'--'}}</view></view><view class="card_three"><view class="item1 flexs flexc"><view class="one"> 共计： </view><view class="right"><text class="thr">{{"￥"+detail.order_amount_total}}</text></view></view></view><view class="card_two flexs flexc"><view class="left f-blod"> 支付方式: </view><view class="right">{{''+(detail.status=='1'?'--':detail.pay_type_text||'--')+''}}</view></view><block wx:if="{{$root.g1}}"><view class="card_four"><view class="title">安装完成拍照</view><view class="f-size-24 color-9 mt-10 mb-20">至少1张、最多9张；保存后用户在订单中可查看</view><view class="install_photo_grid"><block wx:for="{{installPhotoPreview}}" wx:for-item="p" wx:for-index="i"><view class="install_ph_wrap"><image class="install_ph" src="{{p}}" mode="aspectFill" data-event-opts="{{[['tap',[['removeInstallPhoto',[i]]]]]}}" bindtap="__e"></image><view class="install_ph_del_hint">点击删除</view></view></block><block wx:if="{{$root.g2<9}}"><view data-event-opts="{{[['tap',[['chooseInstallPhoto',['$event']]]]]}}" class="install_ph_add" bindtap="__e">+</view></block></view><block wx:if="{{$root.g3>0}}"><view class="content_Bom a-center j-center d-flex"><view data-event-opts="{{[['tap',[['saveInstallPhotos',['$event']]]]]}}" class="btm2" bindtap="__e">{{savingPhotos?'提交中…':'保存照片'}}</view></view></block></view></block><view class="content_Bom a-center d-flex j-sb"><block wx:if="{{$root.m0==='11'}}"><view data-event-opts="{{[['tap',[['storeReceiveGoodsClick',['$event']]]]]}}" class="btm2" bindtap="__e"> 确认收到货 </view></block><block wx:if="{{$root.m1==='12'}}"><view data-event-opts="{{[['tap',[['storeConfirmUserArrivedScan',['$event']]]]]}}" class="btm2" bindtap="__e"> 扫码确认到店 </view></block></view><block wx:if="{{$root.g4}}"><view class="content_Bom a-center d-flex j-sb"><view data-event-opts="{{[['tap',[['resold_orderApi']]]]}}" class="btm2" bindtap="__e"> 拒绝退款 </view><view data-event-opts="{{[['tap',[['refund_orderApi']]]]}}" class="btm1" bindtap="__e"> 同意退款 </view></view></block></view></view>