page {
  background: #F6F7FB;
}
.head {
  position: relative;
  height: 410rpx;
  overflow: hidden;
}
.head .head_img {
  width: 100%;
  height: 410rpx;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.head .rules-entry {
  position: absolute;
  top: 34rpx;
  right: 28rpx;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 30rpx;
}
.head .user {
  position: relative;
  z-index: 4;
  font-weight: 400;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  margin-top: 100rpx;
}
.head .user image {
  border-radius: 50%;
  width: 118rpx;
  height: 118rpx;
  border: 4rpx solid #FFFFFF;
}
.box_2 {
  width: 699rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 34rpx 44rpx;
  box-sizing: border-box;
  margin: -70rpx auto 0;
  position: relative;
  z-index: 4;
}
.box_2 .box_2_bom_left {
  font-weight: 400;
  font-size: 28rpx;
  color: #3D3D3D;
}
.box_2 .box_2_bom_left image {
  width: 32rpx;
  height: 32rpx;
}
.box_2 .box_2_top_two {
  justify-content: space-around;
}
.box_2 .box_2_top .box_2_item {
  flex: 1;
}
.box_2 .box_2_top .box_2_item .box_2_item_text {
  font-weight: 600;
  font-size: 41rpx;
  color: #036045;
  text-align: center;
}
.box_2 .box_2_top .box_2_item .box_2_item_text_2 {
  font-weight: 400;
  font-size: 28rpx;
  color: #3D3D3D;
  text-align: center;
  margin-top: 20rpx;
}
.box_3 {
  margin: 20rpx auto;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.box_3 .box_item {
  padding: 32rpx 26rpx 14rpx;
  box-sizing: border-box;
  width: 330rpx;
  height: 174rpx;
  background: #FFFFFF;
  border-radius: 12rpx 12rpx 12rpx 12rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.box_3 .box_item image {
  width: 95rpx;
  height: 95rpx;
}
.box_3 .box_item .box_3_item_left {
  width: 170rpx;
}
.shop_btn {
  width: 100%;
  height: 80rpx;
  text-align: center;
  line-height: 80rpx;
  background-color: #036045;
  color: #FFFFFF;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}
.shop_btn_secondary {
  background-color: #FFFFFF;
  color: #036045;
  border: 2rpx solid #036045;
  box-sizing: border-box;
  line-height: 76rpx;
}

