<view><view class="popBox"><view class="popBox_title text-center f-bold"> 收银台 </view><view class="text-center color-ff3767 f-bold mb-20"><label class="f-size-22 _span">¥</label><label class="f-size-36 _span">{{after_total}}</label></view><u-count-down vue-id="f51e81d0-1" time="{{time}}" format="mm:ss" autoStart="{{true}}" millisecond="true" data-event-opts="{{[['^change',[['onChange']]]]}}" bind:change="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="time text-center f-size-24 color-9"><text class="time__item">剩余支付时间</text><text class="time__item">{{timeData.minutes+" 分"}}</text><text class="time__item">{{timeData.seconds+" 秒"}}</text></view></u-count-down><view class="f-size-28 mb-20 mt-20 f-bold"> 请选择支付方式 </view><view class="popBox_content"><radio-group><block wx:for="{{pay_type}}" wx:for-item="item" wx:for-index="index" wx:key="*this"><label class="uni-list-cell uni-list-cell-pd"><block wx:if="{{item=='wechat'}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({index})}}" class="popBox_content_item" bindtap="__e"><view class="d-flex j-sb a-center" style="width:90%;"><view>微信支付</view><radio value="{{index}}" checked="{{index===current}}"></radio></view></view></block><block wx:if="{{item=='yue'}}"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" data-event-params="{{({index})}}" class="popBox_content_item" bindtap="__e"><view class="d-flex j-sb a-center" style="width:90%;"><view>余额支付</view><view><block wx:if="{{vuex_token&&type==2}}"><label class="mr-20 f-size-28 color-6 _span">{{"剩余余额:"+(vuex_user.money||0.00)}}</label></block><radio value="{{index}}" checked="{{index===current}}"></radio></view></view></view></block></label></block></radio-group></view><block wx:if="{{wx_show}}"><view data-event-opts="{{[['tap',[['payorder',['$event']]]]]}}" class="payBtn" bindtap="__e"> 确认支付 </view></block><block wx:else><view data-event-opts="{{[['tap',[['createApi',['$event']]]]]}}" class="payBtn" bindtap="__e"> 确认支付 </vie